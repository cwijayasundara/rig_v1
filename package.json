{
  "name": "rig-plugin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test scripts/*.spec.ts && npm run test:e2e:unit && npm run test:e2e:fast",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "validate": "claude plugin validate .claude-plugin/plugin.json",
    "test:e2e": "node tests/e2e/run.mjs --driver live",
    "test:e2e:fast": "node tests/e2e/run.mjs --driver scripted",
    "test:e2e:stacks": "node tests/e2e/stacks.mjs",
    "eval": "node eval/run.mjs",
    "eval:dry": "node eval/run.mjs --dry --runs 1",
    "test:e2e:unit": "node --test tests/e2e/lib/*.test.mjs tests/e2e/driver/*.test.mjs eval/*.test.mjs",
    "eval:chart": "node eval/chart.mjs",
    "eval:chart:dry": "node eval/chart.mjs --dry --runs 1",
    "eval:wiki": "node --disable-warning=ExperimentalWarning eval/wiki.mjs",
    "eval:wiki:dry": "node --disable-warning=ExperimentalWarning eval/wiki.mjs --dry --runs 1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
