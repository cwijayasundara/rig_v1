{
  "stack": "node",
  "paths": ["src/**"],
  "layers": [
    "layer domain src/*/domain/**",
    "layer app src/*/app/**",
    "layer infra src/*/infra/**",
    "layer http src/*/http/**",
    "allow app -> domain",
    "allow infra -> domain",
    "allow http -> app, domain"
  ],
  "test": "node --test"
}
