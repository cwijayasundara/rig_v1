{
  "stack": "go",
  "markers": ["go.mod"],
  "paths": { "tests": ["**/*_test.go"], "testSupport": ["**/testdata/**"] },
  "contracts": { "files": [], "validate": "", "run": "" },
  "sensors": [
    { "id": "types", "cmd": "go vet ./...", "cadence": "turn", "blocks": true, "guide": "go vet must pass before the turn ends." },
    { "id": "lint", "cmd": "golangci-lint run", "cadence": "turn", "blocks": true, "guide": "golangci-lint must pass; fix the code rather than adding nolint." },
    { "id": "unit", "cmd": "go test ./...", "cadence": "turn", "blocks": true, "guide": "Run go test before claiming done; fix the code, never the tests." },
    { "id": "layers", "cmd": "go-arch-lint check", "cadence": "commit", "blocks": true, "guide": "Respect the component rules in .go-arch-lint.yml." },
    { "id": "duplication", "cmd": "d=$(mktemp -d) && npx --yes jscpd@5.4.2 . --ignore \"**/.rig/**,**/.claude/**\" --silent --reporters json --output \"$d\" >&2 && node -p \"try{require('$d/jscpd-report.json').statistics.total.percentage}catch{0}\"", "cadence": "commit", "blocks": true, "ratchet": "down", "guide": "Reuse existing code instead of copying it; the duplicated share may not grow past its baseline." },
    { "id": "audit", "cmd": "govulncheck ./...", "cadence": "ci", "blocks": false, "guide": "Do not call code with known vulnerabilities." },
    { "id": "mutation", "cmd": "go-mutesting ./...", "cadence": "nightly", "blocks": false, "guide": "Tests must assert behaviour so that changing the code makes them fail." }
  ]
}
