{
  "stack": "python",
  "markers": ["pyproject.toml", "requirements.txt", "setup.py"],
  "paths": { "tests": ["**/test_*.py", "**/*_test.py", "**/tests/**"], "testSupport": ["**/conftest.py", "**/fixtures/**"] },
  "contracts": { "files": [], "validate": "", "run": "" },
  "sensors": [
    { "id": "lint", "cmd": "ruff check --force-exclude --extend-exclude .rig,.claude {files}", "cadence": "edit", "blocks": true, "guide": "Ruff must pass on every file you touch; fix the code rather than the rule." },
    { "id": "types", "cmd": "mypy --exclude '^\\.(rig|claude)/' .", "cadence": "turn", "blocks": true, "guide": "The project must type-check with mypy before the turn ends." },
    { "id": "unit", "cmd": "pytest -q", "cadence": "turn", "blocks": true, "guide": "Run pytest before claiming done; fix the code, never the tests." },
    { "id": "layers", "cmd": "if [ -f .rig/gen/importlinter.ini ]; then PYTHONPATH=src lint-imports --config .rig/gen/importlinter.ini; fi", "cadence": "commit", "blocks": true, "guide": "Respect the approved layers in architecture.md; do not import across a forbidden boundary." },
    { "id": "duplication", "cmd": "d=$(mktemp -d) && npx --yes jscpd@5.4.2 . --ignore \"**/.rig/**,**/.claude/**\" --silent --reporters json --output \"$d\" >&2 && node -p \"try{require('$d/jscpd-report.json').statistics.total.percentage}catch{0}\"", "cadence": "commit", "blocks": true, "ratchet": "down", "guide": "Reuse existing code instead of copying it; the duplicated share may not grow past its baseline." },
    { "id": "audit", "cmd": "pip-audit", "cadence": "ci", "blocks": false, "guide": "Do not add dependencies with known vulnerabilities." },
    { "id": "mutation", "cmd": "mutmut run", "cadence": "nightly", "blocks": false, "guide": "Tests must assert behaviour so that changing the code makes them fail." }
  ]
}
