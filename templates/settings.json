{
  "$comment": "Project settings for the sdlc harness. Merge into <project>/.claude/settings.json and commit. superpowers is on because rig's start, chart and plan skills invoke its brainstorming and writing-plans skills (CLAUDE.md's routing line keeps sdlc in charge of routing); turn off any other plugin your team does not use here too. Evidence is protected by these rules and by CI, which recomputes every verdict: a shell script can still write a file, so CI plus branch protection is the boundary. ENABLE_STOP_REVIEW=0 turns off the security-guidance plugin's review on every Stop and SubagentStop (an agentic Opus review of the whole diff, twice, per turn): rig's Opus reviewer at the PR node is the one review per change; its commit and push reviews stay. CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 makes every subagent return before the turn goes on: rig's skills wait for their agents, and a headless session otherwise backgrounds them and ends its turn with the work unfinished. The Skill rules let one rig skill continue into the next (build → test → pr) in an unattended session; approve and waive are never listed.",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "model": "claude-sonnet-5-5",
  "autoCompactWindow": 200000,
  "permissions": {
    "allow": [
      "Edit(.rig/**)",
      "Bash(node --disable-warning=ExperimentalWarning .rig/bin/sdlc.ts *)",
      "Skill(rig:start)",
      "Skill(rig:start *)",
      "Skill(rig-start)", "Skill(rig-start *)",
      "Skill(rig:plan)",
      "Skill(rig:plan *)",
      "Skill(rig-plan)", "Skill(rig-plan *)",
      "Skill(rig:build)",
      "Skill(rig:build *)",
      "Skill(rig-build)", "Skill(rig-build *)",
      "Skill(rig:test)",
      "Skill(rig:test *)",
      "Skill(rig-test)", "Skill(rig-test *)",
      "Skill(rig:pr)",
      "Skill(rig:pr *)",
      "Skill(rig-pr)", "Skill(rig-pr *)",
      "Skill(rig:rule)",
      "Skill(rig:rule *)",
      "Skill(rig:arch)",
      "Skill(rig:arch *)",
      "Skill(rig:app)",
      "Skill(rig:app *)",
      "Skill(rig-rule)", "Skill(rig-rule *)",
      "Skill(rig-arch)", "Skill(rig-arch *)", "Skill(rig-app)", "Skill(rig-app *)",
      "Skill(rig:chart)", "Skill(rig:chart *)", "Skill(rig-chart)", "Skill(rig-chart *)",
      "Skill(rig:testplan)", "Skill(rig:testplan *)", "Skill(rig-testplan)", "Skill(rig-testplan *)",
      "Skill(rig:wiki)", "Skill(rig:wiki *)", "Skill(rig-wiki)", "Skill(rig-wiki *)",
      "Skill(rig:learn)", "Skill(rig:learn *)", "Skill(rig-learn)", "Skill(rig-learn *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr view *)"
    ],
    "ask": [
      "Edit(/.rig/sensors.json)",
      "Edit(/.rig/rules.json)",
      "Edit(/.rig/layers.approved.json)",
      "Edit(/.rig/ratchets.json)",
      "Edit(/.rig/gen/**)",
      "Edit(/.rig/lessons.md)",
      "Edit(/.rig/lessons-archive.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.rig/bin/**)",
      "Edit(/.rig/githooks/**)",
      "Edit(/.rig/mod/**)",
      "Edit(/.rig/guides/**)",
      "Edit(/.github/workflows/rig-*.yml)",
      "Edit(/CODEOWNERS)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/migrations/**)",
      "Edit(/infra/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(/.rig/changes/*/approval.json)",
      "Edit(/.rig/product/sprints/**/approval.json)",
      "Edit(/.rig/product/sprints/**/waivers.json)",
      "Edit(/.rig/waivers.jsonl)",
      "Edit(/.rig/.gate)",
      "Edit(/.rig/.baseline)",
      "Edit(/.rig/unresolved.json)",
      "Edit(/.rig/gates.jsonl)",
      "Edit(/.rig/changes/*/evidence/runs.jsonl)",
      "Edit(/.rig/changes/*/verify.json)",
      "Edit(/.rig/changes/*/pr.md)"
    ]
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "true",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5"
  }
}
