diff --git a/src/orders/orders.js b/src/orders/orders.js
index 798e0df..d2f74f5 100644
--- a/src/orders/orders.js
+++ b/src/orders/orders.js
@@ -90,6 +90,13 @@ export function listOrders() {
   return orders.map(o => structuredClone(o.order)).reverse()
 }
 
+// The orders of one customer, newest first by placedAt; each line is { sku, qty }.
+export function customerOrders(customer) {
+  return orders.map(o => o.order).filter(o => o.customer === customer)
+    .sort((a, b) => b.placedAt.localeCompare(a.placedAt))
+    .map(o => ({ id: o.id, status: o.status, placedAt: o.placedAt, payableCents: o.payableCents, lines: o.lines.map(l => ({ sku: l.sku, qty: l.qty })) }))
+}
+
 export function refundOrder(id) {
   const entry = orders.find(o => o.order.id === id)
