diff --git a/test/customer-orders.test.js b/test/customer-orders.test.js
new file mode 100644
index 0000000..6629ff0
--- /dev/null
+++ b/test/customer-orders.test.js
@@ -0,0 +1,28 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { Catalog } from '../src/catalog/products.js'
+import { createHandler } from '../src/http/handler.js'
+import { loadOrders } from '../src/orders/orders.js'
+
+const order = (id, customer, placedAt, lines, payableCents = 450) => ({ id, customer, status: 'paid', version: 1, lines, payableCents, placedAt })
+const get = (handle, name) => handle({ method: 'GET', path: `/customers/${encodeURIComponent(name)}/orders` })
+
+test('B20 a customer\'s orders come newest first with their lines', () => {
+  loadOrders([
+    order('ORD-0001', 'ada', '2026-01-01T10:00:00.000Z', [{ sku: 'TEA-001', qty: 2 }]),
+    order('ORD-0002', 'bob', '2026-01-02T10:00:00.000Z', [{ sku: 'MUG-002', qty: 1 }]),
+    order('ORD-0003', 'ada', '2026-01-03T10:00:00.000Z', [{ sku: 'TEA-001', qty: 1 }, { sku: 'MUG-002', qty: 3 }], 4650),
+  ])
+  const r = get(createHandler(new Catalog()), 'ada')
+  assert.equal(r.status, 200)
+  assert.equal(r.body.customer, 'ada')
+  assert.deepEqual(r.body.orders.map(o => o.id), ['ORD-0003', 'ORD-0001'])
+  assert.deepEqual(r.body.orders[0], { id: 'ORD-0003', status: 'paid', placedAt: '2026-01-03T10:00:00.000Z', payableCents: 4650, lines: [{ sku: 'TEA-001', qty: 1 }, { sku: 'MUG-002', qty: 3 }] })
+})
+
+test('B20 a customer with no orders is 404 with an error', () => {
+  loadOrders([order('ORD-0001', 'ada', '2026-01-01T10:00:00.000Z', [{ sku: 'TEA-001', qty: 1 }])])
+  const r = get(createHandler(new Catalog()), 'nobody')
+  assert.equal(r.status, 404)
+  assert.equal(typeof r.body.error, 'string')
+})
