+// The customer's orders page (B21): it shows what GET /customers/<name>/orders answers, as an HTML table.
+import { dollars } from '../money.js'
+
+const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
+const lineName = (catalog, sku) => catalog.get(sku)?.name ?? sku
+
+// answer is { status, body } as the endpoint gives it; the page is a whole HTML document.
+export function renderCustomerPage(customer, answer, catalog) {
+  let main
+  if (answer.status !== 200) {
+    main = `<div role="alert">${esc(answer.body.error)}</div>`
+  } else {
+    const rows = answer.body.orders.map(o => `<tr><td>${esc(o.id)}</td><td>${esc(o.status)}</td><td>${esc(o.placedAt.slice(0, 10))}</td><td>$${dollars(o.payableCents / 100)}</td><td>${o.lines.map(l => `<div>${esc(lineName(catalog, l.sku))} x ${l.qty}</div>`).join('')}</td></tr>`).join('')
+    main = `<table><thead><tr><th>Order</th><th>Status</th><th>Placed</th><th>Total</th><th>Items</th></tr></thead><tbody>${rows}</tbody></table>`
+  }
+  return `<!doctype html><html><head><meta charset="utf-8"><title>Orders of ${esc(customer)}</title></head><body><h1>Orders of ${esc(customer)}</h1>${main}</body></html>`
+}
