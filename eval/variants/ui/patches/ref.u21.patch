diff --git a/test/customer-page.test.js b/test/customer-page.test.js
new file mode 100644
index 0000000..fef9fea
--- /dev/null
+++ b/test/customer-page.test.js
@@ -0,0 +1,26 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { Catalog } from '../src/catalog/products.js'
+import { createHandler } from '../src/http/handler.js'
+import { loadOrders } from '../src/orders/orders.js'
+
+const page = name => createHandler(new Catalog())({ method: 'GET', path: `/ui/customers/${encodeURIComponent(name)}` })
+
+test('B21 the page has one row per order with its id, status, date and total', () => {
+  loadOrders([
+    { id: 'ORD-0001', customer: 'ada', status: 'paid', version: 1, lines: [{ sku: 'TEA-001', qty: 2 }], payableCents: 450, placedAt: '2026-01-01T10:00:00.000Z' },
+    { id: 'ORD-0002', customer: 'ada', status: 'shipped', version: 1, lines: [{ sku: 'MUG-002', qty: 3 }], payableCents: 4650, placedAt: '2026-01-03T10:00:00.000Z' },
+  ])
+  const r = page('ada')
+  assert.equal(r.status, 200)
+  assert.match(r.headers['content-type'], /text\/html/)
+  assert.equal(r.body.split('<tr>').length - 1, 3, 'a header row and two order rows')
+  for (const text of ['ORD-0001', 'ORD-0002', 'paid', 'shipped', '2026-01-03', '4.50', '46.50']) assert.ok(r.body.includes(text), text)
+})
+
+test('B21 a name with markup is escaped', () => {
+  loadOrders([{ id: 'ORD-0001', customer: 'a<b>&c', status: 'paid', version: 1, lines: [{ sku: 'TEA-001', qty: 1 }], payableCents: 450, placedAt: '2026-01-01T10:00:00.000Z' }])
+  const r = page('a<b>&c')
+  assert.ok(r.body.includes('a&lt;b&gt;&amp;c'))
+  assert.ok(!r.body.includes('<b>'))
+})
