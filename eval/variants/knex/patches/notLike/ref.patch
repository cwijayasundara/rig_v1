diff --git a/test/unit/query/where-not-like.js b/test/unit/query/where-not-like.js
new file mode 100644
index 0000000..41191ed
--- /dev/null
+++ b/test/unit/query/where-not-like.js
@@ -0,0 +1,37 @@
+'use strict';
+
+const { expect } = require('chai');
+const PG_Client = require('../../../lib/dialects/postgres');
+
+const client = new PG_Client({ client: 'pg' });
+const qb = () => client.queryBuilder();
+
+describe('whereNotLike, whereNotILike', () => {
+  it('whereNotLike negates whereLike', () => {
+    const q = qb().select('*').from('users').whereNotLike('name', 'luk%');
+    expect(q.toSQL().sql).to.equal('select * from "users" where "name" not like ?');
+    expect(q.toSQL().bindings).to.eql(['luk%']);
+  });
+
+  it('whereNotILike negates whereILike', () => {
+    const q = qb().select('*').from('users').whereNotILike('name', 'luk%');
+    expect(q.toSQL().sql).to.equal('select * from "users" where "name" not ilike ?');
+  });
+
+  it('orWhereNotLike and orWhereNotILike keep the or', () => {
+    const q = qb()
+      .select('*')
+      .from('users')
+      .where('id', 1)
+      .orWhereNotLike('name', 'a%')
+      .orWhereNotILike('name', 'b%');
+    expect(q.toSQL().sql).to.equal(
+      'select * from "users" where "id" = ? or "name" not like ? or "name" not ilike ?'
+    );
+  });
+
+  it('a later where is not negated', () => {
+    const q = qb().from('users').whereNotLike('name', 'a%').whereLike('name', 'b%');
+    expect(q.toSQL().sql).to.equal('select * from "users" where "name" not like ? and "name" like ?');
+  });
+});
