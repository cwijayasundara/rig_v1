+  // An upsert (insert with onConflict) of no rows resolves to [] without a connection or a query.
+  runner(builder) {
+    const runner = super.runner(builder);
+    const run = runner.run.bind(runner);
+    runner.run = async () => {
+      const { _method, _single } = builder;
+      if (
+        _method === 'insert' &&
+        _single &&
+        _single.onConflict &&
+        Array.isArray(_single.insert) &&
+        _single.insert.length === 0
+      ) {
+        return [];
+      }
+      return run();
+    };
+    return runner;
+  }
