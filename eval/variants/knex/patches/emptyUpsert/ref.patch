index 0000000..360a82e
--- /dev/null
+++ b/test/unit/query/empty-upsert.js
@@ -0,0 +1,57 @@
+'use strict';
+
+const { expect } = require('chai');
+const knex = require('../../../knex');
+
+describe('empty upsert', () => {
+  for (const client of ['pg', 'mysql', 'sqlite3']) {
+    describe(client, () => {
+      let db;
+      let queries;
+      beforeEach(() => {
+        db = knex({ client, useNullAsDefault: true });
+        queries = [];
+        db.client.acquireConnection = () => {
+          throw new Error('no connection expected');
+        };
+        db.on('query', (q) => queries.push(q));
+      });
+      afterEach(() => db.destroy());
+
+      it('resolves to [] and runs no query on ignore', async () => {
+        const res = await db('t').insert([]).onConflict('id').ignore();
+        expect(res).to.deep.equal([]);
+        expect(queries).to.have.length(0);
+      });
+
+      it('resolves to [] and runs no query on merge', async () => {
+        const res = await db('t').insert([]).onConflict('id').merge();
+        expect(res).to.deep.equal([]);
+        expect(queries).to.have.length(0);
+      });
+    });
+  }
+
+  it('still rejects a plain empty insert', async () => {
+    const db = knex({
+      client: 'sqlite3',
+      connection: { filename: ':memory:' },
+      useNullAsDefault: true,
+    });
+    try {
+      await db('t').insert([]);
+      expect.fail('should have rejected');
+    } catch (e) {
+      expect(e.message).to.contain('The query is empty');
+    } finally {
+      await db.destroy();
+    }
+  });
+
+  it('keeps the old compiled SQL for an array of empty objects', () => {
+    const db = knex({ client: 'sqlite3', useNullAsDefault: true });
+    const sql = db('t').insert([{}]).onConflict('id').ignore().toSQL();
+    expect(sql.sql).to.contain('insert into');
+    return db.destroy();
+  });
+});
