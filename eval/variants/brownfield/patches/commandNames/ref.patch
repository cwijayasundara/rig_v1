+  /**
+   * The names and aliases of all the subcommands, at any depth, sorted, each
+   * name once even when it is used in several places.
+   *
+   * @return {string[]}
+   */
+
+  commandNames() {
+    const names = new Set();
+    const collect = (cmd) => {
+      cmd.commands.forEach((sub) => {
+        names.add(sub.name());
+        sub.aliases().forEach((alias) => names.add(alias));
+        collect(sub);
+      });
+    };
+    collect(this);
+    return [...names].sort();
+  }
+
