@@ -0,0 +1,29 @@
+const commander = require('../');
+
+describe('.commandNames()', () => {
+  test('when no subcommands then empty array', () => {
+    expect(new commander.Command().commandNames()).toEqual([]);
+  });
+
+  test('when subcommands and aliases then sorted names and aliases', () => {
+    const program = new commander.Command();
+    program.command('remove').alias('rm');
+    program.command('add');
+    expect(program.commandNames()).toEqual(['add', 'remove', 'rm']);
+  });
+
+  test('when nested subcommands then names at every depth', () => {
+    const program = new commander.Command();
+    const remote = program.command('remote');
+    remote.command('add');
+    remote.command('prune');
+    expect(program.commandNames()).toEqual(['add', 'prune', 'remote']);
+  });
+
+  test('when a name is used twice then listed once', () => {
+    const program = new commander.Command();
+    program.command('add');
+    program.command('remote').command('add');
+    expect(program.commandNames()).toEqual(['add', 'remote']);
+  });
+});
