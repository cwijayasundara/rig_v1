diff --git a/tests/option.requires.test.js b/tests/option.requires.test.js
new file mode 100644
index 0000000..121f0f7
--- /dev/null
+++ b/tests/option.requires.test.js
@@ -0,0 +1,32 @@
+const commander = require('../');
+
+describe('option.requires()', () => {
+  function makeProgram() {
+    const program = new commander.Command();
+    program
+      .exitOverride()
+      .configureOutput({ writeErr: () => {}, writeOut: () => {} })
+      .addOption(new commander.Option('--cert <file>').requires('key'))
+      .addOption(new commander.Option('--key <file>'));
+    return program;
+  }
+
+  test('when the required option is given then no error', () => {
+    const program = makeProgram();
+    program.parse(['node', 'test', '--cert', 'a.pem', '--key', 'a.key']);
+    expect(program.opts()).toEqual({ cert: 'a.pem', key: 'a.key' });
+  });
+
+  test('when the required option is missing then error', () => {
+    const program = makeProgram();
+    expect(() => program.parse(['node', 'test', '--cert', 'a.pem'])).toThrow(
+      "error: option '--cert <file>' requires option '--key <file>'",
+    );
+  });
+
+  test('when the requiring option is not given then no error', () => {
+    const program = makeProgram();
+    program.parse(['node', 'test', '--key', 'a.key']);
+    expect(program.opts()).toEqual({ key: 'a.key' });
+  });
+});
