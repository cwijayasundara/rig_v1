diff --git a/lib/option.js b/lib/option.js
index bded840..4426e28 100644
--- a/lib/option.js
+++ b/lib/option.js
@@ -133,6 +133,28 @@ class Option {
     return this;
   }
 
+  /**
+   * Collect each use of the option, given as `key=value`, into an object.
+   * The key is everything before the first `=` and the value is the rest.
+   *
+   * @example
+   * new Option('-D, --define <pair>').keyValue();
+   * // -D a=1 --define b=2  =>  { a: '1', b: '2' }
+   *
+   * @return {Option}
+   */
+
+  keyValue() {
+    this.parseArg = (value, previous) => {
+      const split = value.indexOf('=');
+      if (split < 1) {
+        throw new InvalidArgumentError('Expected key=value.');
+      }
+      return { ...previous, [value.slice(0, split)]: value.slice(split + 1) };
+    };
+    return this;
+  }
+
   /**
    * Whether the option is mandatory and must have a value after parsing.
